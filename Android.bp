////////////////////////////////
// KleidiCV
////////////////////////////////

kleidicv_common_cxx_flags = [
    "-DANDROID",
    "-O2",
    "-g0",
    "-fomit-frame-pointer",
    "-fno-stack-protector",
    "-fno-exceptions",
    "-fno-rtti",
    "-fno-unroll-loops",
    "-Wall",
    "-Wextra",
    "-Wold-style-cast",
    "-Wno-shadow",
    "-mllvm ",
    "-inline-threshold=10000",
]

kleidicv_common_include_dirs = [
    "build",
    "build/3rdparty/kleidicv/kleidicv-0.3.0/kleidicv/include",
    "build/3rdparty/kleidicv/include",
]

cc_defaults {
    name: "kleidicv_defaults",
    vendor_available: true,
    compile_multilib: "64",
    rtti: true,
    cflags: kleidicv_common_cxx_flags,
    local_include_dirs: kleidicv_common_include_dirs,
}

cc_library_static {
    name: "libkleidicv_neon",
    defaults: ["kleidicv_defaults"],

    cflags: kleidicv_common_cxx_flags + [
        "-march=armv8-a",
        "-DKLEIDICV_TARGET_NEON=1",
    ],
    srcs: [
        "build/3rdparty/kleidicv/kleidicv-0.3.0/kleidicv/src/**/*_neon.cpp",
    ],
}

cc_library_static {
    name: "libkleidicv_sve2",
    defaults: ["kleidicv_defaults"],

    cflags: kleidicv_common_cxx_flags + [
        "-march=armv8-a+sve2",
        "-DKLEIDICV_TARGET_SVE2=1",
    ],
    srcs: [
        "build/3rdparty/kleidicv/kleidicv-0.3.0/kleidicv/src/**/*_sve2.cpp",
    ],
}

cc_library_static {
    name: "libkleidicv",
    defaults: ["kleidicv_defaults"],

    cflags: kleidicv_common_cxx_flags + [
        "-DKLEIDICV_HAVE_SVE2",
    ],
    srcs: [
        "build/3rdparty/kleidicv/kleidicv-0.3.0/kleidicv/src/**/*_api.cpp",
    ],
    whole_static_libs: [
        "libkleidicv_neon",
        "libkleidicv_sve2",
    ],
}

cc_library_static {
    name: "libkleidicv_thread",
    defaults: ["kleidicv_defaults"],

    cflags: [
        "-DANDROID",
        "-O2",
        "-g0",
        "-fno-exceptions",
        "-fno-rtti",
        "-Wall",
        "-Wextra",
        "-Wold-style-cast",
        "-Wno-shadow",
    ],
    local_include_dirs: kleidicv_common_include_dirs + [
        "build/3rdparty/kleidicv/kleidicv-0.3.0/kleidicv_thread/include",
    ],
    srcs: [
        "build/3rdparty/kleidicv/kleidicv-0.3.0/kleidicv_thread/src/*.cpp",
    ],
    static_libs: [
        "libkleidicv",
    ],
}

cc_library_static {
    name: "libkleidicv_hal",
    defaults: ["kleidicv_defaults"],

    cflags: kleidicv_common_cxx_flags + [
        "-DKLEIDICV_HAVE_SVE2",
        "-Wno-old-style-cast",
    ],
    local_include_dirs: kleidicv_common_include_dirs + [
        "build/3rdparty/kleidicv/kleidicv-0.3.0/adapters/opencv",
        "build/3rdparty/kleidicv/kleidicv-0.3.0/kleidicv_thread/include",
        "modules/core/include",
        "modules/imgproc/include",
    ],
    srcs: [
        "build/3rdparty/kleidicv/kleidicv-0.3.0/adapters/opencv/kleidicv_hal.cpp",
    ],
    static_libs: [
        "libkleidicv",
        "libkleidicv_thread"
    ],
}

