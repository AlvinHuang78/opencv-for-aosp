////////////////////////////////
// OpenCV modules
////////////////////////////////

opencv_common_c_flags = [
    "-DANDROID",
    "-std=c++11",
    "-O3",
    "-g",
    "-DNDEBUG",
    "-D_USE_MATH_DEFINES",
    "-D__OPENCV_BUILD=1",
    "-D__STDC_CONSTANT_MACROS",
    "-D__STDC_FORMAT_MACROS",
    "-D__STDC_LIMIT_MACROS",
    "-D_FORTIFY_SOURCE=2",
    "-fPIC",
    "-fexceptions",
    "-fdata-sections",
    "-ffunction-sections",
    "-funwind-tables",
    "-fstack-protector-strong",
    "-fsigned-char",
    "-fdiagnostics-show-option",
    "-fvisibility=hidden",
    "-fvisibility-inlines-hidden",
    "-no-canonical-prefixes"
]

opencv_common_export_include_dirs = [
    "build",
    "include",
]

opencv_common_include_dirs = [
    "build/3rdparty/kleidicv/include",
    "build/3rdparty/kleidicv/kleidicv-0.3.0/kleidicv/include",
    "build/3rdparty/kleidicv/kleidicv-0.3.0/kleidicv_thread/include",
]

opencv_common_shared_libs = [
    "libdl",
    "liblog",
    "libm",
]

opencv_common_static_libs = [
    "libkleidicv",
    "libkleidicv_hal",
    "libkleidicv_thread",
]

cc_defaults {
    name: "opencv_defaults",
    vendor_available: true,
    compile_multilib: "64",
    rtti: true,
    cflags: opencv_common_c_flags,
    export_include_dirs: opencv_common_export_include_dirs,
    local_include_dirs: opencv_common_include_dirs,
    shared_libs: opencv_common_shared_libs,
    whole_static_libs: opencv_common_static_libs,
}

cc_library_static {
    name: "libopencv_calib3d",
    defaults: ["opencv_defaults"],

    export_include_dirs: opencv_common_export_include_dirs + [
        "modules/calib3d/include",
    ],
    local_include_dirs: opencv_common_include_dirs + [
        "build/modules/calib3d",
    ],
    srcs: [
        "build/modules/calib3d/opencl_kernels_calib3d.cpp",
        "modules/calib3d/src/*.cpp",
        "modules/calib3d/src/usac/*.cpp",
    ],
    static_libs: [
        "libopencv_core",
        "libopencv_features2d",
        "libopencv_flann",
        "libopencv_imgproc",
    ],
}

cc_library_static {
    name: "libopencv_core_matmul_neon_dotprod",
    defaults: ["opencv_defaults"],

    cflags: opencv_common_c_flags + [
        "-DOPENCV_ALLOCATOR_STATS_COUNTER_TYPE=int",
        "-DCV_CPU_DISPATCH_MODE=NEON_DOTPROD",
        "-DCV_CPU_COMPILE_NEON_DOTPROD=1",
        "-march=armv8.2-a+dotprod",
    ],
    local_include_dirs: opencv_common_include_dirs + [
        "build/modules/core",
        "modules/core/include",
    ],
    srcs: [
        "build/modules/core/matmul.neon_dotprod.cpp",
    ],
}

cc_library_static {
    name: "libopencv_core",
    defaults: ["opencv_defaults"],

    cflags: opencv_common_c_flags + [
        "-DOPENCV_ALLOCATOR_STATS_COUNTER_TYPE=int",
        // Needed by: modules/core/CMakeFiles/opencv_core.dir/src/alloc.cpp
        "-DHAVE_POSIX_MEMALIGN=1",
        "-DHAVE_MALLOC_H=1",
        "-DHAVE_MEMALIGN=1",
        // Needed by: modules/core/src/parallel/parallel.cpp
        "-DPARALLEL_ENABLE_PLUGINS=1",
        // Needed by: modules/core/src/system.cpp
        "-DHAVE_CPUFEATURES=1",
    ],
    export_include_dirs: opencv_common_export_include_dirs + [
        "modules/core/include",
    ],
    local_include_dirs: opencv_common_include_dirs + [
        "3rdparty/cpufeatures",
        "build/modules/core",
    ],
    include_dirs: [
        "external/zlib",
    ],
    srcs: [
        "build/modules/core/opencl_kernels_core.cpp",
        "modules/core/src/*.cpp",
        "modules/core/src/parallel/*.cpp",
        "modules/core/src/opencl/*.cpp",
        "modules/core/src/utils/*.cpp",
    ],
    whole_static_libs: opencv_common_static_libs + [
        "libopencv_core_matmul_neon_dotprod",
        "libcpufeatures",
        "libz",
    ],
}

cc_library_static {
    name: "libopencv_features2d",
    defaults: ["opencv_defaults"],

    export_include_dirs: opencv_common_export_include_dirs + [
        "modules/features2d/include",
    ],
    local_include_dirs: opencv_common_include_dirs + [
        "build/modules/features2d",
    ],
    srcs: [
        "build/modules/features2d/opencl_kernels_features2d.cpp",
